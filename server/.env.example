# Firebase Admin (choose one option)
# Option A: full service account JSON
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option B: individual cert fields
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C: path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Resend - passwordless sign-in (magic link) emails
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
# Must be a sender on a domain verified in Resend
RESEND_FROM=NetGecko <no-reply@yourdomain.com>

# Africa's Talking - phone number OTP sign-in SMS
AT_API_KEY=atsk_XXXXXXXXXXXXXXXXXXXXXXXX
# Live app username (not "sandbox")
AT_USERNAME=your-at-app-username
# Optional alphanumeric sender ID (must be registered with AT)
# AT_SENDER_ID=NetGecko

# Comma-separated emails that always get NetGecko Admin (all partners) — test accounts
# AUTH_ADMIN_EMAILS=tester@example.com
